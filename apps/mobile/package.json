{
  "name": "@luka/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "build": "expo export --platform ios && if grep -rqs LUKA_DEV_SEED dist; then echo 'El cargador de datos de prueba quedó en el bundle de producción' >&2; exit 1; fi",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@luka/domain": "workspace:*",
    "@luka/schema-sqlite": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@luka/config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.13",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sql.js": "^1.14.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|uuid|standard-navigation))"
    ],
    "testTimeout": 20000,
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}

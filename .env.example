# Valores falsos para desarrollo local (documento 08). Copia a .env; nunca versiones el .env real.
APP_ENV=local
DATABASE_URL=postgres://luka:luka@localhost:5432/luka
REDIS_URL=redis://localhost:6379

# Se generan en local y no se versionan.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=cambia-esto-en-local

APPLE_CLIENT_ID=com.ejemplo.luka

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=luka-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=luka-local
S3_SECRET_KEY=luka-local-secret

SMTP_URL=smtp://localhost:1025

# Vacío en local.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Termina dentro de la app: jamás un secreto.
EXPO_PUBLIC_API_URL=http://localhost:3000

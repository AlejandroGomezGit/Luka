# Valores falsos para desarrollo local (documento 08). Copia a .env; nunca versiones el .env real.
APP_ENV=local
# La API se conecta como luka_app (sin superusuario ni BYPASSRLS, AM-03); las migraciones, como dueño.
DATABASE_URL=postgres://luka_app:luka-app-local@localhost:15432/luka
MIGRATION_DATABASE_URL=postgres://luka:luka@localhost:15432/luka
REDIS_URL=redis://localhost:6379

# Clave del HMAC que esconde correos e IP en Redis (ADR-015). Falsa; en producción, del gestor de secretos.
RATE_LIMIT_KEY_SECRET=falso-solo-local-cambiar-en-produccion
# Detrás de un balanceador: sus direcciones o rangos, separados por comas; en producción ni true ni un número (T-040).
TRUST_PROXY=false

# Se generan en local y no se versionan.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=cambia-esto-en-local

APPLE_CLIENT_ID=com.ejemplo.luka

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=luka-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=luka-local
S3_SECRET_KEY=luka-local-secret

SMTP_URL=smtp://localhost:1025

# Vacío en local.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Termina dentro de la app: jamás un secreto.
EXPO_PUBLIC_API_URL=http://localhost:3000

    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "2.2.1",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",

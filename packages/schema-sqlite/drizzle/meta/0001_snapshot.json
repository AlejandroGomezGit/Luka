        },
        "transactions_category_confidence": {
          "name": "transactions_category_confidence",
          "value": "\"transactions\".\"category_confidence\" between 0 and 100"
        },
        "transactions_inv01_amount_sign": {
          "name": "transactions_inv01_amount_sign",
          "value": "\"transactions\".\"amount_minor\" <> 0 and (\n        (\"transactions\".\"kind\" in ('expense', 'transfer') and \"transactions\".\"amount_minor\" < 0)\n        or (\"transactions\".\"kind\" = 'income' and \"transactions\".\"amount_minor\" > 0)\n        or \"transactions\".\"kind\" = 'adjustment')"
        },
        "transactions_inv02_transfer": {
          "name": "transactions_inv02_transfer",
          "value": "(\"transactions\".\"kind\" = 'transfer' and \"transactions\".\"to_account_id\" is not null\n          and \"transactions\".\"to_account_id\" <> \"transactions\".\"account_id\" and \"transactions\".\"to_amount_minor\" > 0)\n        or (\"transactions\".\"kind\" <> 'transfer' and \"transactions\".\"to_account_id\" is null and \"transactions\".\"to_amount_minor\" is null)"
        }
      }

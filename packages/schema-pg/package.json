    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@luka/domain": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@jest/globals": "^30.5.2",
    "@luka/config": "workspace:*",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "postgres": "^3.4.9"
  }
}

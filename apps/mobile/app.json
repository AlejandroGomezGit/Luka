{
  "expo": {
    "name": "Luka",
    "slug": "luka",
    "version": "0.1.0",
    "scheme": "luka",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ejemplo.luka"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

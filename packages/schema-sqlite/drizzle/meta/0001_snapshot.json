          "value": "\"transactions\".\"category_source\" in ('user', 'rule', 'model', 'import')"
        },
        "transactions_source": {
          "name": "transactions_source",
          "value": "\"transactions\".\"source\" in ('manual', 'import_csv', 'import_pdf', 'message_paste', 'message_shortcut', 'bank', 'receipt_scan', 'recurring')"
        },
        "transactions_review_status": {
